---
// The short, direct answer at the top of a page. Search engines and AI
// assistants often lift this paragraph word for word, so keep it factual.
interface Props { text: string; label?: string }
const { text, label = 'Quick answer' } = Astro.props;
---
<aside class="quick-answer" aria-label={label}>
  <p class="qa-label">{label}</p>
  <p class="qa-text">{text}</p>
</aside>
<style>
  .quick-answer { background: #fff; border: 1px solid var(--line); border-left: 5px solid var(--brand); border-radius: 0 var(--radius) var(--radius) 0; padding: 16px 20px; margin: 0 0 28px; max-width: var(--read); box-shadow: var(--shadow); }
  .qa-label { margin: 0 0 4px; font-weight: 800; color: var(--brand-dark); text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.08em; }
  .qa-text { margin: 0; font-size: 1.08rem; }
</style>
