---
import { SITE } from '../config';
---
<a href="/" class="logo" aria-label={`${SITE.name} home`}>
  <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
    <rect width="34" height="34" rx="8" fill="#b4441c" />
    <path d="M6 18 17 8l11 10" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M10 16v10h14V16" fill="none" stroke="#fff" stroke-width="2.4" stroke-linejoin="round" />
  </svg>
  <span>Birmingham <strong>Roof Quotes</strong></span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--slate); font-size: 1.08rem; white-space: nowrap; }
  .logo strong { color: var(--brand); }
</style>
